# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# GEMINI_API_KEY and other non-public values must stay server-only. The optional
# GA4 measurement ID at the bottom is public and is intentionally NEXT_PUBLIC_.

# Key from Google AI Studio (aistudio.google.com). Leave empty to run every tool
# in clearly labelled demo mode (ready-made content, not AI).
GEMINI_API_KEY=

# "gemini-flash-latest" is a documented Google alias that always points at the newest
# Flash model. If you get "model not found" (check the server terminal for a 404 hint),
# list the models your key can use and paste an exact id here, for example gemini-3.8-flash.
GEMINI_MODEL=gemini-flash-latest

# Safety cap on real AI calls per day, counted per server instance.
AI_DAILY_LIMIT=400

# Optional GA4 Measurement ID (format: G-...). Analytics stays disabled until
# this is set and a visitor explicitly accepts analytics in the consent notice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
